#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = [
#     "httpx",
# ]
# ///
"""web-search — Searches the web via Brave Search API and outputs clean markdown results."""

import sys
import os
import json
import time
import argparse
import platform
import resource
from pathlib import Path
from datetime import datetime, timezone

TOOL_DIR = Path(__file__).resolve().parent
HISTORY_FILE = TOOL_DIR / "history.jsonl"
ENDPOINT = "https://api.search.brave.com/res/v1/web/search"


def load_env() -> None:
    """Loads environment variables from .env if present in main/, repo root, or tool directory."""
    candidates = [
        TOOL_DIR.parents[2] / ".env",  # main/.env
        TOOL_DIR.parents[3] / ".env",  # repo root .env
        TOOL_DIR / ".env",             # tool local .env
    ]
    for env_path in candidates:
        if env_path.is_file():
            try:
                for line in env_path.read_text(encoding="utf-8").splitlines():
                    line = line.strip()
                    if line and not line.startswith("#") and "=" in line:
                        key, _, value = line.partition("=")
                        key = key.strip()
                        value = value.strip().strip("'\"")
                        if key and key not in os.environ:
                            os.environ[key] = value
                break
            except Exception:
                pass


def mask_secret(secret: str) -> str:
    """Safely masks secrets for terminal display and logs."""
    if not secret:
        return "(none)"
    if len(secret) <= 6:
        return "***"
    return secret[:3] + "..." + secret[-3:]


def get_peak_rss_mb() -> float:
    """Returns peak Resident Set Size (RSS) memory in megabytes."""
    usage = resource.getrusage(resource.RUSAGE_SELF)
    if platform.system() == "Darwin":
        return round(usage.ru_maxrss / (1024 * 1024), 2)
    else:
        return round(usage.ru_maxrss / 1024, 2)


def search(query: str, count: int, api_key: str) -> list[dict]:
    """Queries Brave Search API and returns a list of results."""
    import httpx

    if not api_key:
        print(
            "Error: BRAVE_API_KEY not found.\n"
            "Please set BRAVE_API_KEY in your shell environment or in main/.env.\n"
            "Free API keys can be obtained at https://brave.com/search/api/",
            file=sys.stderr,
        )
        sys.exit(1)

    headers = {
        "Accept": "application/json",
        "Accept-Encoding": "gzip",
        "X-Subscription-Token": api_key,
    }
    params = {
        "q": query,
        "count": count,
    }

    try:
        response = httpx.get(ENDPOINT, headers=headers, params=params, timeout=15.0)
        response.raise_for_status()
    except Exception as e:
        print(f"Error during search request: {e}", file=sys.stderr)
        sys.exit(1)

    data = response.json()
    raw_results = data.get("web", {}).get("results", [])

    results = []
    for r in raw_results:
        results.append({
            "title": r.get("title", "(no title)"),
            "url": r.get("url", ""),
            "description": r.get("description", "(no snippet)"),
        })

    return results


def format_results(query: str, results: list[dict]) -> str:
    """Formats search results as readable markdown."""
    lines = [f"## Search Results for: \"{query}\"", ""]

    if not results:
        lines.append("No results found.")
        return "\n".join(lines)

    for i, r in enumerate(results, 1):
        lines.append(f"### {i}. {r['title']}")
        lines.append(f"**URL:** {r['url']}")
        lines.append(f"{r['description']}")
        lines.append("")

    return "\n".join(lines)


def run_dry_run(query: str, count: int, api_key: str) -> None:
    """Executes a simulation of the tool, verifying inputs, side effects, outputs, and telemetry."""
    t0 = time.perf_counter_ns()

    print("\n" + "═" * 68)
    print(" 🔍 DRY-RUN SIMULATION: web-search")
    print("═" * 68)

    # 1. Inputs
    print("\n[1] INPUTS (Parameters & Environment Verification)")
    print(f"    ✓ Query parameter: {query!r}")
    count_valid = 1 <= count <= 20
    count_icon = "✓" if count_valid else "❌"
    print(f"    {count_icon} Count parameter: {count} (allowed range: 1..20)")
    key_status = f"present and valid ({mask_secret(api_key)})" if api_key else "❌ MISSING (set BRAVE_API_KEY in .env)"
    print(f"    ✓ Secret BRAVE_API_KEY: {key_status}")

    # 2. Side Effects
    print("\n[2] SIDE EFFECTS (Contract Effects Inspection)")
    print(f"    ⚡ NETWORK (SIMULATED - 0 actual requests performed):")
    print(f"       → BLOCKED HTTP GET call to: {ENDPOINT}")
    print(f"       → Payload that would be sent: {{'q': {query!r}, 'count': {count}}}")
    print(f"       → Authorization header: X-Subscription-Token: {mask_secret(api_key)}")
    print(f"    📁 FILESYSTEM:")
    print(f"       → Reads: only `.env` for credentials resolution")
    print(f"       → Writes: 0 files created or modified (contract compliant)")
    print(f"       → Deletions: 0 files removed")
    print(f"    ⚙️ SUBPROCESSES:")
    print(f"       → 0 external shell processes or commands spawned")

    # 3. Outputs
    exit_code = 0 if (count_valid and api_key) else 1
    print("\n[3] OUTPUTS (Output Format Preview)")
    print(f"    → Exit Code: {exit_code}")
    print(f"    → Channel STDERR: diagnostics and progress logs")
    print(f"    → Channel STDOUT: Markdown formatted text:")
    print("      " + "-" * 50)
    print(f"      ## Search Results for: {query!r}")
    print(f"      ### 1. [Simulated Result Title]")
    print(f"      **URL:** https://example.com/sample-article")
    print(f"      [Sample descriptive snippet from search engine...]")
    print("      " + "-" * 50)

    t1 = time.perf_counter_ns()
    duration_ms = round((t1 - t0) / 1_000_000, 2)
    peak_rss = get_peak_rss_mb()
    usage = resource.getrusage(resource.RUSAGE_SELF)

    print("\n" + "═" * 68)
    if not api_key:
        status = "WARN"
        print(" ⚠️  RESULT: CONTRACT VIOLATED (BRAVE_API_KEY missing)")
    elif not count_valid:
        status = "FAIL"
        print(" ❌ RESULT: INVALID COUNT PARAMETER")
    else:
        status = "PASS"
        print(" 🎉 RESULT: 100% CONTRACT COMPLIANT")

    print(f" 📊 Telemetry: {duration_ms} ms wall-clock | Peak RAM: {peak_rss} MB")
    print(f" 📝 Appended execution receipt to: history.jsonl")
    print("═" * 68 + "\n")

    # Record rudimentary JSON telemetry
    receipt = {
        "timestamp": datetime.now(timezone.utc).isoformat(),
        "tool": "web-search",
        "mode": "dry-run",
        "status": status,
        "exit_code": exit_code,
        "args": {"query": query, "count": count},
        "telemetry": {
            "duration_ms": duration_ms,
            "peak_rss_mb": peak_rss,
            "cpu_user_ms": round(usage.ru_utime * 1000, 2),
            "cpu_sys_ms": round(usage.ru_stime * 1000, 2),
        },
    }
    try:
        with open(HISTORY_FILE, "a", encoding="utf-8") as f:
            f.write(json.dumps(receipt) + "\n")
    except Exception as e:
        print(f"Warning: Failed to write history.jsonl: {e}", file=sys.stderr)

    sys.exit(exit_code)


def main():
    parser = argparse.ArgumentParser(description="Search the web via Brave Search API")
    parser.add_argument("query", help="Search query string")
    parser.add_argument("--count", "-n", type=int, default=5, help="Number of results (default: 5, max: 20)")
    parser.add_argument("--dry-run", "-d", action="store_true", help="Simulate execution without making external network calls")
    args = parser.parse_args()

    load_env()
    api_key = os.environ.get("BRAVE_API_KEY", "").strip()

    if args.dry_run:
        run_dry_run(args.query, args.count, api_key)
        return

    print(f"Searching for: {args.query!r}...", file=sys.stderr)
    results = search(args.query, count=args.count, api_key=api_key)
    output = format_results(args.query, results)
    print(output)


if __name__ == "__main__":
    main()
