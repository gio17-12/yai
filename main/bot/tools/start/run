#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = []
# ///
"""start — session bootstrap: regenerates tools index, then prints date/time + directory tree of main/."""

from pathlib import Path
from datetime import datetime
import re

TOOL_DIR = Path(__file__).resolve().parent
TEMPLATES_DIR = TOOL_DIR / "templates" if (TOOL_DIR / "templates").is_dir() else (TOOL_DIR / "config" / "templates")
ROOT_DIR = TOOL_DIR.parents[2]   # resolves main/ directory regardless of cwd
TOOLS_DIR = TOOL_DIR.parent      # resolves bot/tools/ directory

EXCLUDE = set()  # exact file or folder names to exclude in addition to hidden files


def tree(dir_path: Path, prefix: str = "") -> list[str]:
    lines = []
    entries = sorted(
        (e for e in dir_path.iterdir() if not e.name.startswith(".") and e.name not in EXCLUDE),
        key=lambda e: (e.is_file(), e.name),
    )
    for i, entry in enumerate(entries):
        is_last = i == len(entries) - 1
        connector = "└── " if is_last else "├── "
        lines.append(f"{prefix}{connector}{entry.name}")
        if entry.is_dir():
            new_prefix = prefix + ("    " if is_last else "│   ")
            lines.extend(tree(entry, new_prefix))
    return lines


def render_tree() -> str:
    if not ROOT_DIR.is_dir():
        return "⚠️  Root not found (expected cwd = main/)."
    lines = tree(ROOT_DIR)
    return "\n".join(lines) if lines else "(empty)"


def extract_blurb(readme_text: str) -> str:
    """Extracts content of the '## Description' section, or empty string if not present."""
    match = re.search(r"## Description\s*\n(.+?)(?=\n##|\Z)", readme_text, re.DOTALL)
    if not match:
        return ""
    return " ".join(match.group(1).split())  # collapse newlines/whitespace into a single paragraph


def scan_tools() -> list[tuple[str, str]]:
    """Returns [(tool_name, blurb), ...] for each subfolder in bot/tools/ with a README.md."""
    if not TOOLS_DIR.is_dir():
        return []
    results = []
    for entry in sorted(TOOLS_DIR.iterdir()):
        if not entry.is_dir() or entry.name.startswith("."):
            continue
        readme = entry / "README.md"
        if not readme.exists():
            continue
        blurb = extract_blurb(readme.read_text())
        results.append((entry.name, blurb))
    return results


def render_index() -> str:
    tools = scan_tools()
    if not tools:
        lines = "(no tools found)"
    else:
        lines = "\n".join(
            f"- **{name}** — {blurb}" if blurb else f"- **{name}**"
            for name, blurb in tools
        )
    template = (TEMPLATES_DIR / "index.md").read_text()
    return template.replace("{{TOOLS}}", lines)


def regen_tools_index() -> None:
    try:
        content = render_index()
        (TOOLS_DIR / "README.md").write_text(content)
    except Exception as e:
        print(f"⚠️  Tool index regeneration failed: {e}\n")


def main():
    regen_tools_index()

    now = datetime.now()
    template = (TEMPLATES_DIR / "output.md").read_text()
    output = (
        template
        .replace("{{DATE}}", now.strftime("%Y-%m-%d"))
        .replace("{{WEEKDAY}}", now.strftime("%A"))
        .replace("{{TIME}}", now.strftime("%H:%M"))
        .replace("{{TREE}}", render_tree())
    )
    print(output)


if __name__ == "__main__":
    main()